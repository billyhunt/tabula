{
  "name": "tabula",
  "productName": "Tabula",
  "description": "A local whiteboard for macOS, built on Excalidraw",
  "author": "Billy Hunt",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "postinstall": "node scripts/copy-fonts.mjs && node scripts/brand-dev-electron.mjs",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "package": "npm run licenses && npm run build && electron-builder --mac --dir && node scripts/open-app.mjs",
    "open": "node scripts/open-app.mjs",
    "test": "vitest run",
    "licenses": "node scripts/collect-licenses.mjs",
    "test:e2e": "npm run build && playwright test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@excalidraw/excalidraw": "0.18.0-43a92e6",
    "@excalidraw/mermaid-to-excalidraw": "2.2.2",
    "@fontsource/archivo": "^5.3.0",
    "@fontsource/archivo-black": "^5.3.0",
    "@fontsource/dm-mono": "^5.3.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "lz-string": "^1.5.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vite-plugin-electron": "^1.1.2",
    "vitest": "^5.0.5"
  },
  "license": "MIT"
}
